#!/usr/bin/env python3
"""DAIO (Dual-Agent Iteration Orchestrator) One-Click CLI.

Usage:
    ./daio          # Start autonomous dual-agent iteration loop
    ./daio board    # Open visual live taskboard in browser
    ./daio status   # Print current phase, taskboard state & safety breaker metrics\n    ./daio recover  # Diagnose/recover stale or missing cross-session context\n    ./daio checkpoint # Refresh durable recovery checkpoint\n    ./daio sync       # Show Git/Engineer/Architect synchronization health
"""
import argparse
import asyncio
import os
import subprocess
import sys
from pathlib import Path

# Add project root to sys.path
PROJECT_ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(PROJECT_ROOT))

def open_board():
    """Open taskboard.html in default system browser."""
    board_path = PROJECT_ROOT / "taskboard.html"
    if not board_path.exists():
        print(f"❌ taskboard.html not found at {board_path}")
        return
    print(f"📊 Opening DAIO Live Taskboard: {board_path}")
    if sys.platform == "darwin":
        subprocess.run(["open", str(board_path)])
    elif sys.platform.startswith("linux"):
        subprocess.run(["xdg-open", str(board_path)])
    elif sys.platform == "win32":
        os.startfile(str(board_path))

def show_status():
    """Show current taskboard status."""
    from scripts.daio_taskboard import TaskboardManager
    tb = TaskboardManager(str(PROJECT_ROOT))
    print("=" * 70)
    print("🤖 DAIO Dual-Agent System Status")
    print("=" * 70)
    print(f"📁 Project Root : {PROJECT_ROOT.name}")
    print(f"📋 Total Tasks  : {len(tb.tasks)}")
    print(f"📜 Audit Events : {len(tb.history)}")
    print("\n--- Tasks State ---")
    for t in tb.tasks:
        st = t.get("status", "TODO")
        sym = "✅" if st == "DONE" else ("⚙️" if st == "IN_PROGRESS" else ("🧐" if st == "REVIEW" else "📝"))
        phase = t.get("phase", "N/A")
        print(f" {sym} [{st:<12}] {phase:<12} : {t.get('title')}")
    print("=" * 70)

def run_loop(auto_open_board: bool = False):
    """Run DAIO Autonomous Loop."""
    from scripts.daio_orchestrator import UniversalDAIO
    from skills.daio.scripts.daio_taskboard import TaskboardManager
    
    # Refresh board state first
    tb = TaskboardManager(str(PROJECT_ROOT))
    tb.save()
    
    if auto_open_board:
        open_board()
    
    print("🚀 Starting DAIO Autonomous Orchestration Loop...")
    import json
    cfg_path = PROJECT_ROOT / "daio_config.json"
    cfg = json.loads(cfg_path.read_text(encoding="utf-8")) if cfg_path.exists() else {}
    orchestrator = UniversalDAIO(
        url_pattern=cfg.get("target_browser_url", "chatgpt.com"),
        initial_phase=cfg.get("current_phase", "PHASE_1"),
        exec_cmd=cfg.get("execution_command"),
        test_cmd=cfg.get("test_gate_command", "pytest tests/"),
        report_file=cfg.get("report_file_path"),
        project_root=cfg.get("project_root", str(PROJECT_ROOT)),
        max_iterations=cfg.get("max_iterations", 15),
        consecutive_errors_cap=cfg.get("consecutive_errors_cap", 3),
        auto_git=cfg.get("auto_git_sync", True),
    )
    asyncio.run(orchestrator.run_loop())

def recover_context(write_checkpoint=False):
    """Diagnose cross-session state; optionally refresh checkpoint."""
    from scripts.daio_recovery import diagnose, checkpoint
    d = diagnose(os.getcwd())
    print("=" * 70)
    print("♻️ DAIO Robust Recovery")
    print("=" * 70)
    print(f"Project : {d['project_root']}")
    print(f"Health  : {d['health']}")
    print(f"HEAD    : {d['head']}")
    print(f"Cached  : {d['checkpoint_head'] or 'NONE'}")
    if d["recent_commits"]:
        print("\nCommits since cached checkpoint:")
        for line in d["recent_commits"]: print(f"  {line}")
    if write_checkpoint:
        s=checkpoint(d["project_root"], agent="DAIO-CLI")
        print(f"\n✓ Checkpoint refreshed at {s['checkpoint_head']}")
    elif d["health"] != "SYNCED":
        print("\nRecovery required: reconcile repository evidence before execution.")
    return d

def show_sync():
    from scripts.daio_sync import sync_status
    s=sync_status(os.getcwd())
    print("=" * 70)
    print(f"🔄 DAIO Three-Party Sync: {s['overall']} | HEAD {s['head']}")
    print("=" * 70)
    for name,item in s["participants"].items():
        print(f"{name:<10} {item['state']:<8} checkpoint={item.get('checkpoint_head','NONE')}")
    return s

def main():
    parser = argparse.ArgumentParser(description="DAIO One-Click CLI")
    parser.add_argument("action", nargs="?", default="run", choices=["run", "board", "status", "recover", "checkpoint", "sync"],
                        help="Action to perform: run (default), board (open browser), status (print state)")
    parser.add_argument("--open-board", "-b", action="store_true", help="Automatically open live taskboard in browser when running loop")
    args = parser.parse_args()

    if args.action == "board":
        open_board()
    elif args.action == "status":
        show_status()
    elif args.action == "recover":
        recover_context(False)
    elif args.action == "checkpoint":
        recover_context(True)
    elif args.action == "sync":
        show_sync()
    else:
        # Check if running interactively in terminal
        should_open = args.open_board
        if not should_open and sys.stdin.isatty():
            try:
                ans = input("📊 是否要在瀏覽器中開啟即時對話看板 (Live Taskboard)？[Y/n]: ").strip().lower()
                if ans in ["", "y", "yes"]:
                    open_board()
            except (EOFError, KeyboardInterrupt):
                pass
        run_loop(auto_open_board=False)

if __name__ == "__main__":
    main()
