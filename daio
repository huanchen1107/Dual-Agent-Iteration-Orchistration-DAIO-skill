#!/usr/bin/env python3
"""DAIO (Dual-Agent Iteration Orchestrator) Productized CLI (Generic DAIO v2.1).

Usage:
    daio init       # Initialize DAIO environment in current project
    daio start      # Start autonomous dual-agent closed-loop worker
    daio doctor     # Diagnose environment, CLI backend, and CDP connectivity
    daio status     # Print current active work items, stage, and metrics
    daio board      # Open visual live taskboard in browser
"""
import argparse
import asyncio
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
from typing import Optional
import urllib.request
import uuid


PROJECT_ROOT = Path.cwd()

# Add script resolution paths
for p in [
    PROJECT_ROOT / "_daio" / "scripts",
    PROJECT_ROOT / "scripts",
    Path(__file__).resolve().parent / "scripts",
    PROJECT_ROOT
]:
    if p.exists() and str(p) not in sys.path:
        sys.path.insert(0, str(p))


def do_init():
    """Initialize DAIO control-plane directory and configuration in target project."""
    daio_dir = PROJECT_ROOT / "_daio"
    daio_dir.mkdir(parents=True, exist_ok=True)
    (daio_dir / "evidence").mkdir(parents=True, exist_ok=True)

    cfg_file = daio_dir / "daio_config.json"
    if not cfg_file.exists():
        default_cfg = {
            "project_name": PROJECT_ROOT.name,
            "provider": "AUTO",
            "architect_endpoint": {
                "provider": "CHATGPT_WEB",
                "routing_policy": "EXACT_CONVERSATION"
            },
            "cdp_url": "http://127.0.0.1:9222",
            "test_gate_command": "pytest tests/ -q",
            "allowed_scope": ["src/*", "tests/*"],
            "frozen_paths": [".env*", "secrets/*"]
        }
        cfg_file.write_text(json.dumps(default_cfg, indent=2), encoding="utf-8")
        print(f"📄 Created default configuration at: {cfg_file}")
    else:
        print(f"ℹ️ Existing configuration found at: {cfg_file}")

    print(f"✅ DAIO initialized successfully in {PROJECT_ROOT}")


def do_doctor():
    """Diagnose local system environment, coding agent backends, and CDP."""
    print("=" * 70)
    print("🩺 DAIO Doctor — System & Backend Capability Diagnostics")
    print("=" * 70)
    print(f"📁 Project Root : {PROJECT_ROOT}")
    print(f"🐍 Python Version: {sys.version.split()[0]} ({sys.executable})")

    # 1. Check Antigravity CLI ('agy')
    agy_path = shutil.which("agy") or str(Path.home() / ".local" / "bin" / "agy")
    if agy_path and os.path.exists(agy_path) and os.access(agy_path, os.X_OK):
        try:
            ver = subprocess.run([agy_path, "--version"], capture_output=True, text=True, timeout=5).stdout.strip()
            print(f"🤖 Antigravity CLI: FOUND ({agy_path}) -> Version {ver}")
        except Exception as e:
            print(f"🤖 Antigravity CLI: FOUND ({agy_path}) but failed checking version: {e}")
    else:
        print("🤖 Antigravity CLI: NOT FOUND (Install with: curl -fsSL https://antigravity.google/cli/install.sh | bash)")

    # 2. Check Gemini Credentials
    has_gemini = bool(os.environ.get("GEMINI_API_KEY") or os.environ.get("GOOGLE_API_KEY"))
    print(f"🔑 Gemini API Key : {'CONFIGURED' if has_gemini else 'NOT FOUND (Optional fallback)'}")

    # 3. Check Chrome CDP Port 9222
    try:
        req = urllib.request.urlopen("http://localhost:9222/json/version", timeout=3)
        data = json.loads(req.read().decode("utf-8"))
        print(f"🌐 Chrome CDP Port 9222 : CONNECTED ({data.get('Browser', 'Chrome')})")
    except Exception as e:
        print(f"🌐 Chrome CDP Port 9222 : DISCONNECTED ({e})")
        print("   (To enable: /Applications/Google\\ Chrome.app/Contents/MacOS/Google\\ Chrome --remote-debugging-port=9222)")

    # 4. Check Git Status
    try:
        head = subprocess.run(["git", "rev-parse", "HEAD"], cwd=PROJECT_ROOT, capture_output=True, text=True).stdout.strip()
        print(f"📦 Git Repository : READY (HEAD: {head[:8]})")
    except Exception:
        print("📦 Git Repository : NOT INITIALIZED (Run 'git init')")

    print("=" * 70)


def do_status():
    """Print current DAIO work item status with full S5.5 & Handoff Watchdog observability."""
    db_path = PROJECT_ROOT / "_daio" / "daio_work.db"
    if not db_path.exists():
        db_path = PROJECT_ROOT / "_daio" / "daio_work_state.db"
    if not db_path.exists():
        print(f"ℹ️ No active DAIO database at {PROJECT_ROOT / '_daio' / 'daio_work.db'}. Run 'daio init' first.")
        return

    try:
        from daio_closed_loop.store import SqliteDAIOWorkStore
        from daio_closed_loop.models import DAIOStatus, DAIOGate
        from daio_closed_loop.watchdog import DAIOHandoffWatchdog

        store = SqliteDAIOWorkStore(db_path=str(db_path))
        watchdog = DAIOHandoffWatchdog(store=store, project_root=str(PROJECT_ROOT))
        items = store.list_all_work_items()

        print("=" * 75)
        print("🤖 DAIO Work Board & Continuous Orchestration Status")
        print("=" * 75)
        print(f"Total Work Items: {len(items)}\n")
        for idx, w in enumerate(items, 1):
            last_dec = w.last_decision or (w.metadata.get("last_architect_decision", {}).get("decision") if w.metadata else None) or "NONE"
            auth_next = w.authorized_next_phase or (w.metadata.get("authorized_next_phase") if w.metadata else None) or "NONE"
            pending_trans = f"{w.current_stage} -> {auth_next}" if auth_next != "NONE" else "NONE"
            human_req = (w.status == DAIOStatus.HUMAN_GATE_REQUIRED or w.current_gate == DAIOGate.HUMAN_GATE)

            print(f"[{idx}] Work ID                  : {w.work_id}")
            print(f"    current_work_id          : {w.work_id}")
            print(f"    current_phase            : {w.current_stage}")
            print(f"    last_architect_decision  : {last_dec}")
            print(f"    authorized_next_phase    : {auth_next}")
            print(f"    pending_transition       : {pending_trans}")
            print(f"    claimed_next_work_id     : {w.claimed_by or w.lease_id or 'NONE'}")
            print(f"    worker_state             : {w.status.value}")
            print(f"    human_action_required    : {human_req}")
            if w.requested_action:
                print(f"    action_summary           : {w.requested_action[:75]}")
            print("-" * 75)

        print("\n" + watchdog.get_status_summary())
        print("=" * 75)
    except Exception as e:
        print(f"❌ Error reading status: {e}")


def do_rpc_status():
    """Print current canonical Two-Plane Remote Project Cockpit (RPC-1) status JSON."""
    try:
        from daio_closed_loop.adapters import DAIOStatusCollector
        collector = DAIOStatusCollector(project_root=str(PROJECT_ROOT))
        status_resp = collector.collect_status()
        print(json.dumps(status_resp.to_dict(), indent=2, ensure_ascii=False))
    except Exception as e:
        print(f"❌ Error collecting RPC status: {e}")


def do_rpc_publish(relay_url: Optional[str] = None, token: Optional[str] = None, loop_mode: bool = False, interval: int = 15):
    """Publish current DAIO status to authenticated Cloudflare Relay."""
    from daio_closed_loop.adapters import DAIOStatusCollector, DAIOStatusPublisher

    cfg_file = PROJECT_ROOT / "_daio" / "daio_config.json"
    cfg = {}
    if cfg_file.exists():
        try:
            cfg = json.loads(cfg_file.read_text(encoding="utf-8"))
        except Exception:
            pass

    resolved_url = relay_url or os.environ.get("DAIO_RPC_RELAY_URL") or cfg.get("rpc", {}).get("relay_url") or "https://daio-relay.huanchen1107.workers.dev"
    resolved_token = token or os.environ.get("DAIO_RPC_PUBLISH_TOKEN") or cfg.get("rpc", {}).get("publish_token")

    if not resolved_token:
        print("❌ Error: Missing publish token.")
        print("   Set environment variable: export DAIO_RPC_PUBLISH_TOKEN='<your-token>'")
        print("   Or pass argument: daio rpc-publish --token '<your-token>'")
        return

    collector = DAIOStatusCollector(project_root=str(PROJECT_ROOT))
    publisher = DAIOStatusPublisher(
        collector=collector,
        relay_url=resolved_url,
        publish_token=resolved_token,
        interval_seconds=interval,
    )

    print(f"📡 DAIO RPC-1 Status Publisher -> {resolved_url}")
    if loop_mode:
        print(f"🔄 Running periodic publisher loop (interval: {interval}s)... Press Ctrl+C to stop.")
        try:
            asyncio.run(publisher.run_loop())
        except KeyboardInterrupt:
            print("\n🛑 Stopped RPC publisher loop.")
    else:
        success, detail, status_resp = publisher.publish_once()
        if success:
            proj = status_resp.live_plane.project_name if status_resp else "unknown"
            sha = (status_resp.durable_plane.local_head_sha[:7]) if (status_resp and status_resp.durable_plane.local_head_sha) else "?"
            freshness = status_resp.live_plane.freshness.value if status_resp else "?"
            print(f"✅ Published successfully: {detail} ({proj} | {freshness} | {sha})")
        else:
            print(f"❌ Publication failed: {detail}")



def do_start(daemon: bool = False):
    """Start DAIO Autonomous Supervisor with Queue Poller & Handoff Watchdog."""
    import logging
    logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] %(name)s: %(message)s")
    if daemon:
        print(f"🌟 Starting DAIO Autonomous Supervisor daemon in: {PROJECT_ROOT}")
        from daio_closed_loop.supervisor import start_supervisor_daemon
        daemon_pid = start_supervisor_daemon(project_root=str(PROJECT_ROOT))
        print(f"✅ DAIO Supervisor daemon started successfully. (PID: {daemon_pid})")
        print(f"   Log: {PROJECT_ROOT / '_daio' / 'evidence' / 'supervisor_daemon.log'}")
        print(f"   PID: {PROJECT_ROOT / '_daio' / 'supervisor.pid'}")
    else:
        print(f"🚀 Starting DAIO Autonomous Supervisor in foreground: {PROJECT_ROOT}")
        from daio_closed_loop.supervisor import run_supervisor
        asyncio.run(run_supervisor(project_root=str(PROJECT_ROOT)))


def do_stop():
    """Stop running DAIO Supervisor daemon."""
    from daio_closed_loop.supervisor import stop_supervisor_daemon
    ok = stop_supervisor_daemon(project_root=str(PROJECT_ROOT))
    if ok:
        print(f"🛑 DAIO Supervisor daemon stopped.")
    else:
        print(f"ℹ️ No active DAIO Supervisor daemon found.")


def do_daemon_status():
    """Check DAIO Supervisor daemon status."""
    from daio_closed_loop.supervisor import get_supervisor_daemon_status
    st = get_supervisor_daemon_status(project_root=str(PROJECT_ROOT))
    if st["running"]:
        print(f"🟢 DAIO Supervisor daemon is RUNNING (PID: {st['pid']})")
    else:
        print(f"⚪ DAIO Supervisor daemon is STOPPED")


def do_dispatch(
    change_id: str,
    requested_action: str,
    request_id: Optional[str] = None,
    requested_role: str = "ENGINEERING_EXECUTION",
    allowed_scope: Optional[list[str]] = None,
    completion_evidence_path: Optional[str] = None,
):
    """Submit root work through the canonical durable supervisor inbox."""
    from daio_closed_loop.inbox import DAIORootWorkInbox, RootWorkRequest

    cfg_file = PROJECT_ROOT / "_daio" / "daio_config.json"
    cfg = {}
    if cfg_file.exists():
        cfg = json.loads(cfg_file.read_text(encoding="utf-8"))

    resolved_request_id = request_id or f"dispatch-{uuid.uuid4().hex[:12]}"
    project_id = str(cfg.get("project_id") or cfg.get("project_name") or PROJECT_ROOT.name)
    endpoint = cfg.get("architect_endpoint", {})
    if not isinstance(endpoint, dict):
        raise ValueError("architect_endpoint must be an object")

    request = RootWorkRequest(
        schema_version="daio-root-work/v1",
        request_id=resolved_request_id,
        project_id=project_id,
        change_id=change_id,
        requested_action=requested_action,
        requested_role=requested_role,
        allowed_scope=list(allowed_scope or cfg.get("allowed_scope", [])),
        architect_endpoint=endpoint,
        metadata={
            "dispatch_source": "daio-cli",
            **({"completion_evidence_path": completion_evidence_path} if completion_evidence_path else {}),
        },
    )
    submitted = DAIORootWorkInbox.submit_request(PROJECT_ROOT / "_daio" / "inbox", request)
    print(json.dumps({
        "status": "SUBMITTED",
        "request_id": resolved_request_id,
        "work_id": f"daio-root-{resolved_request_id}",
        "inbox_path": str(submitted),
        "schema_version": request.schema_version,
    }, ensure_ascii=False))


def do_takeover():
    """Discover and bind a project to one unambiguous active ChatGPT conversation."""
    from daio_closed_loop.adapters.bridge import extract_chatgpt_identifiers, fetch_cdp_tabs

    git_root_res = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], cwd=PROJECT_ROOT, capture_output=True, text=True
    )
    if git_root_res.returncode != 0:
        raise RuntimeError("DAIO takeover requires a Git repository")
    git_root = Path(git_root_res.stdout.strip()).resolve()
    head = subprocess.run(
        ["git", "rev-parse", "HEAD"], cwd=git_root, capture_output=True, text=True, check=True
    ).stdout.strip()

    tabs = fetch_cdp_tabs(cdp_port=9222)
    candidates = []
    for tab in tabs:
        project_id, conversation_id = extract_chatgpt_identifiers(str(tab.get("url", "")))
        if project_id and conversation_id:
            candidates.append((project_id, conversation_id, tab.get("url", "")))
    unique = sorted(set(candidates))
    if len(unique) != 1:
        raise RuntimeError(
            f"DAIO takeover requires exactly one active ChatGPT Project conversation; discovered {len(unique)}"
        )
    project_id, conversation_id, canonical_url = unique[0]

    daio_dir = git_root / "_daio"
    daio_dir.mkdir(parents=True, exist_ok=True)
    (daio_dir / "evidence").mkdir(parents=True, exist_ok=True)
    cfg_path = daio_dir / "daio_config.json"
    cfg = json.loads(cfg_path.read_text(encoding="utf-8")) if cfg_path.exists() else {}
    cfg.setdefault("project_name", git_root.name)
    cfg.setdefault("project_id", git_root.name)
    cfg.setdefault("provider", "AUTO")
    cfg.setdefault("test_gate_command", "pytest tests/ -q")
    cfg.setdefault("allowed_scope", ["src/**", "tests/**"])
    cfg["architect_endpoint"] = {
        "provider": "CHATGPT_WEB",
        "project_id": project_id,
        "chatgpt_project_id": project_id,
        "conversation_id": conversation_id,
        "canonical_url": canonical_url,
        "routing_policy": "EXACT_CONVERSATION",
    }
    cfg_path.write_text(json.dumps(cfg, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    print(json.dumps({
        "status": "DAIO_READY",
        "project_root": str(git_root),
        "repository_head": head,
        "project_id": project_id,
        "conversation_id": conversation_id,
        "routing_policy": "EXACT_CONVERSATION",
    }, ensure_ascii=False))


def main():
    parser = argparse.ArgumentParser(description="DAIO One-Click CLI (Generic DAIO v2.1)")
    parser.add_argument("action", nargs="?", default="start", choices=["start", "stop", "init", "doctor", "status", "daemon-status", "board", "run", "loop", "rpc-status", "rpc-publish", "dispatch", "create-work", "takeover"],
                        help="Action to perform: start, stop, init, doctor, status, daemon-status, board, rpc-status, rpc-publish, dispatch")
    parser.add_argument("--project", "-C", default=os.environ.get("DAIO_PROJECT_ROOT"), help="Target project root directory (default: current working directory)")
    parser.add_argument("--daemon", "-d", action="store_true", help="Run supervisor in detached background daemon mode")
    parser.add_argument("--relay", default=None, help="Cloudflare Relay URL for RPC publication")
    parser.add_argument("--token", default=None, help="Bearer authorization token for Cloudflare Relay")
    parser.add_argument("--loop", action="store_true", help="Run publisher continuously in a loop")
    parser.add_argument("--interval", type=int, default=15, help="Publishing interval in seconds (default: 15)")
    parser.add_argument("--change-id", help="Change/stage identifier for dispatch")
    parser.add_argument("--request-id", help="Stable idempotency key for dispatch")
    parser.add_argument("--requested-action", help="Engineering or architect action to execute")
    parser.add_argument("--role", default="ENGINEERING_EXECUTION", choices=["ENGINEERING_EXECUTION", "LEAD_ARCHITECT_REVIEW"], help="Initial DAIO role")
    parser.add_argument("--allow", action="append", dest="allowed_scope", help="Allowed workspace glob; repeat as needed")
    parser.add_argument("--completion-evidence", help="Project-relative JSON evidence file containing stdout")
    args = parser.parse_args()

    global PROJECT_ROOT
    if args.project:
        PROJECT_ROOT = Path(args.project).resolve()

    if args.action == "init":
        do_init()
    elif args.action == "doctor":
        do_doctor()
    elif args.action == "status":
        do_status()
    elif args.action == "daemon-status":
        do_daemon_status()
    elif args.action == "stop":
        do_stop()
    elif args.action == "rpc-status":
        do_rpc_status()
    elif args.action == "rpc-publish":
        do_rpc_publish(relay_url=args.relay, token=args.token, loop_mode=args.loop, interval=args.interval)
    elif args.action in ["dispatch", "create-work"]:
        if not args.change_id or not args.requested_action:
            parser.error("dispatch requires --change-id and --requested-action")
        do_dispatch(
            change_id=args.change_id,
            requested_action=args.requested_action,
            request_id=args.request_id,
            requested_role=args.role,
            allowed_scope=args.allowed_scope,
            completion_evidence_path=args.completion_evidence,
        )
    elif args.action == "takeover":
        do_takeover()
    elif args.action in ["start", "loop", "run"]:
        do_start(daemon=args.daemon)
    elif args.action == "board":
        board_path = PROJECT_ROOT / "taskboard.html"
        if board_path.exists():
            subprocess.run(["open", str(board_path)])
        else:
            print(f"❌ Taskboard not found at {board_path}")


if __name__ == "__main__":
    main()
